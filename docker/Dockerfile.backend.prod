# ═══════════════════════════════════════════════════════════════
# MIZAN Backend — Production Dockerfile
# Multi-stage build for minimal image size
# ═══════════════════════════════════════════════════════════════

FROM python:3.12-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt ./requirements.txt
# The VPS runs inference on CPU; install the CPU wheel explicitly so the
# unqualified requirements entry cannot pull several gigabytes of CUDA libraries.
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca; fi; \
    pip install --no-cache-dir --prefix=/install --ignore-installed --no-deps \
      "pip==26.2.1" "setuptools==84.0.0" \
    && PYTHONPATH=/install/lib/python3.12/site-packages \
      python -m pip install --no-cache-dir --prefix=/install \
      --index-url https://download.pytorch.org/whl/cpu "torch==2.14.1+cpu" \
    && PYTHONPATH=/install/lib/python3.12/site-packages \
      python -m pip install --no-cache-dir --prefix=/install -r requirements.txt \
    && PYTHONPATH=/install/lib/python3.12/site-packages \
      python -c "import torch; assert torch.version.cuda is None, 'CPU-only wheel required'"

# ── Production stage ──
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git openssh-client sshpass \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r mizan && useradd -r -g mizan -d /app -s /sbin/nologin mizan

# Replace the base image's installer metadata with the tested current versions.
RUN python -m pip uninstall -y pip setuptools
COPY --from=builder /install /usr/local
RUN python -c "import torch; from importlib.metadata import version; assert torch.version.cuda is None; assert version('pip') == '26.2.1'; assert version('setuptools') == '84.0.0'"

# Backend code, packaged NLP (mizan.nlp), and Ruh model weights/code.
# Build context is the repo root (see docker-compose.prod.yml).
COPY backend/ ./
COPY nlp/ ./nlp/
COPY ruh_model/ ./ruh_model/

RUN mkdir -p /data plugins && chown -R mizan:mizan /app /data

# Entrypoint script for env validation and graceful shutdown
COPY <<'ENTRYPOINT' /entrypoint.sh
#!/bin/bash
set -e

# ── Environment variable validation ──
echo "MIZAN Backend (production) — validating environment..."
MISSING=""

if [ -z "$SECRET_KEY" ]; then
    MISSING="$MISSING SECRET_KEY"
fi

if [ -z "$ANTHROPIC_API_KEY" ] && [ -z "$OPENAI_API_KEY" ] && [ -z "$OLLAMA_URL" ]; then
    echo "WARNING: No LLM provider configured (ANTHROPIC_API_KEY, OPENAI_API_KEY, or OLLAMA_URL)"
fi

if [ -n "$MISSING" ]; then
    echo "ERROR: Missing required environment variables:$MISSING"
    exit 1
fi

echo "Environment validated. Starting MIZAN backend..."

# ── Graceful shutdown: exec replaces shell so PID 1 receives SIGTERM ──
exec "$@"
ENTRYPOINT
RUN chmod +x /entrypoint.sh && chown mizan:mizan /entrypoint.sh

USER mizan

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/ || exit 1

ENTRYPOINT ["/entrypoint.sh"]
# Single worker: auth sessions, API keys, and scheduler state are process-local
# (in-memory). Scale horizontally only after these move to shared stores.
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]
