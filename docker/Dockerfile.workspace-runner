# syntax=docker/dockerfile:1
ARG BASE_REGISTRY=docker.io/library
FROM ${BASE_REGISTRY}/docker:28.5.1-cli@sha256:9190b0613792e658a7783cf14b2d5ace5941bb68ede7276922ea36ee457d76ad AS docker
FROM ${BASE_REGISTRY}/python:3.13-slim-trixie@sha256:7c61056e61ac89e852de05f3dc6fa51a6dd2181797bceed46aa725dd7cb2cd3b
COPY --from=docker /usr/local/bin/docker /usr/local/bin/docker
RUN --mount=type=secret,id=proxy_ca,target=/run/proxy-ca.pem \
    if [ -f /run/proxy-ca.pem ]; then export PIP_CERT=/run/proxy-ca.pem; fi; \
    pip install --no-cache-dir 'fastapi==0.142.2' 'uvicorn==0.54.0'
WORKDIR /app
COPY backend/workspace /app/workspace
ENV PYTHONDONTWRITEBYTECODE=1
# The socket belongs to a dedicated runner daemon, never the public backend.
CMD ["uvicorn", "workspace.runner:app", "--host", "0.0.0.0", "--port", "8080", "--no-access-log"]
