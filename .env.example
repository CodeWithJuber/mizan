# ╔══════════════════════════════════════════════════════╗
# ║          ميزان  ·  MIZAN Configuration               ║
# ║      Copy to .env and fill in your values            ║
# ╚══════════════════════════════════════════════════════╝

# ===== AI PROVIDERS (at least one required) =====
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=                        # Optional
OPENROUTER_API_KEY=                    # Optional — access 300+ models via openrouter.ai
MIZAN_OPENROUTER_FALLBACKS=auto        # auto: free fallbacks for a free primary | none | model,model

# ===== MODEL =====
MIZAN_ORCHESTRATION=mizan              # mizan: MIZAN plans/acts/verifies, LLM only for language | strict | llm
MIZAN_DEBUG_MODE=admins                # Who may compare the base model with MIZAN side by side: admins | users | off
MIZAN_MUHASABA=on                      # Daily self-review: MIZAN corrects arithmetic and quotes it can prove wrong
MIZAN_MURAQABAH=on                     # Watchers: reminders and tasks on schedule, quiet during salah
MIZAN_HARNESS_EVOLUTION=on             # Renew code instructions after failures; keep a version only when proven better
MIZAN_LISAN_MODELS=                    # Optional model IDs for code work, cheapest first (empty: the agent's model)
MIZAN_LISAN_READINESS=0.7              # Verified success a cheaper model needs before it gets the work first
LLM_PROVIDER=auto                     # auto: Anthropic key → OpenRouter → OpenAI; or name one provider
MIZAN_OWNED_ONLY=false                # true blocks hosted inference, including model overrides
MIZAN_REPLY_CHECKPOINT=               # Local trusted own-reply .pt checkpoint; empty abstains
MIZAN_OWNED_LEARNING_DIR=data/owned_learning # Private dir with policy + approved original-data bundles
MIZAN_OWNED_LEARNING_AUTORUN=true     # Train automatically when an approved bundle appears; never uses raw chats
MIZAN_MEMORY_MAINTENANCE=true         # Hourly consolidation, dream replay and ACT-R forgetting
MIZAN_MEMORY_MAINTENANCE_SECONDS=3600
MIZAN_VECTOR_URL=                     # e.g. http://chroma:8000 — semantic recall layer (vector profile)
MIZAN_CHAT_MAX_OUTPUT_TOKENS=         # Per-call output budget; empty = model cap (≤64k), bounded to 256–128000
MIZAN_CHAT_EFFORT=high                # Claude effort: low | medium | high | xhigh | max
MIZAN_LLM_FIRST_PROGRESS_SECONDS=60 # First visible text or tool-argument progress; bounded to 1–180
MIZAN_LLM_BUFFERED_FIRST_PROGRESS_SECONDS=180 # Same, for providers without streaming deltas; 1–900
MIZAN_LLM_PROGRESS_SECONDS=60       # Subsequent meaningful progress; bounded to 1–180
MIZAN_LLM_MAX_CALL_SECONDS=600      # Whole provider call; bounded to 1–1800
MIZAN_CHAT_RUN_SECONDS=1800         # Context, queue and agent execution; bounded to 30–7200
MIZAN_CHAT_MAX_STEPS=100            # Tool rounds per run (not tied to Nafs); then a progress report
MIZAN_CHAT_MAX_CONTINUATIONS=20     # Auto-continuations of a length-limited answer (stops if repeating)
MIZAN_CHAT_TOOL_RESULT_CHARS=20000  # Characters of one tool result sent back to the model
MIZAN_CONTEXT_HISTORY_TOKENS=150000 # History budget cap; older turns become a running summary
MIZAN_CONTEXT_FILL=0.5              # Share of the model context window used for history (0.1–0.8)
MIZAN_ANTHROPIC_COMPACTION=true     # Claude server-side compaction for very long single runs
MIZAN_CHAT_TOOL_SCHEMA_LIMIT=8      # Request-local schema window including discovery; bounded to 2–32
MIZAN_CHAT_TOOL_SCHEMA_BYTES=12288  # UTF-8 schema window budget; bounded to 4096–65536
MIZAN_CHAT_TEMPERATURE=0.5          # Non-Claude providers only (Claude API 2026-10-21 has no sampling params); 0–1
MIZAN_OWNED_DB=data/mizan_owned.sqlite3
MIZAN_RESEARCH_DIR=data/research
MIZAN_SUPPORT_MODEL=                  # Explicit OpenRouter teacher model; support endpoint only
DEFAULT_MODEL=                        # empty = provider default (claude-opus-5-5 on Anthropic)
# Examples: claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5;
# OpenRouter: anthropic/claude-opus-5.5, google/gemini-3.8-flash, qwen/qwen3.8-flash

# ===== AGENT: CONNECTORS (MCP), SKILLS, CODING =====
MIZAN_PUBLIC_URL=                     # e.g. https://mizan.example.com — OAuth callback base; empty = from request
MIZAN_MCP_HOST_STDIO=admin            # Who may run stdio MCP servers on the host: admin | all | off
MIZAN_MCP_ALLOW_PRIVATE_HOSTS=        # Comma-separated private hosts connectors may reach (default none)
MIZAN_PROJECT_SKILLS=true             # Load .agents/skills and .claude/skills from the bound project
# MIZAN_WORKSPACE_MAX_FILE_BYTES=1048576     # per file, max 8 MiB
# MIZAN_WORKSPACE_MAX_PROJECT_BYTES=10485760 # per project, max 100 MiB
# MIZAN_WORKSPACE_MAX_FILES=500              # per project, max 5000

# ===== AGI TEST =====
# ARC_API_KEY=                     # Optional: lets MIZAN's explorer play the official ARC-AGI-3 games (arcprize.org)
# HF_TOKEN=                        # Optional: MIZAN reads your Hugging Face datasets/models (admins only); read-only token is enough

# ===== SYSTEM =====
SECRET_KEY=change-this-to-a-secure-random-string
DEBUG=false
LOG_LEVEL=INFO
RUH_ENABLED=true                      # Rūḥ provider needs a checkpoint: RUH_MODEL_PATH or ruh_model/checkpoints/latest
# ===== SERVER =====
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== PRODUCTION DEPLOYMENT =====
# DOMAIN=mizan.example.com          # Your domain (for SSL)
# HTTP_PORT=80                      # Public HTTP port
# HTTPS_PORT=443                    # Public HTTPS port
# SSL_EMAIL=admin@example.com       # Email for Let's Encrypt
# NGINX_CONF=nginx-nossl.conf       # nginx-nossl.conf or nginx.conf (SSL)
# Custom shutdown grace is a deploy-script environment override, not a plain
# Compose .env setting: MIZAN_GRACEFUL_SHUTDOWN_SECONDS=90 (10–180 seconds).
# scripts/deploy_production.sh derives the matching Docker deadline (+15s).

# ===== DATABASE =====
DB_PATH=data/mizan.db

# ===== LOCAL AI (Optional) =====
OLLAMA_URL=http://localhost:11434

# ===== CLOUD PROVIDERS (Optional) =====
LINODE_API_TOKEN=                      # Linode Personal Access Token (linodes:read_write scope)

# ===== CHANNELS (Optional) =====
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_APP_TOKEN=
WHATSAPP_TOKEN=

# ===== VOICE INPUT (Sama', speech to text on this server) =====
MIZAN_STT=on
MIZAN_STT_MODEL_SIZE=base
MIZAN_STT_DAILY_SECONDS=1800

# ===== EMAIL (Optional) =====
EMAIL_HOST=imap.gmail.com
EMAIL_USER=
EMAIL_PASSWORD=

# ===== MIZAN HYBRID RESEARCH RUNTIME (Optional; disabled by default) =====
# Wraps an existing provider with own-NLP advisory and deterministic gates.
# No weights are merged. This is not production or religious certification.
MIZAN_HYBRID_ENABLED=false
MIZAN_BASE_PROVIDER=openai-compatible
MIZAN_BASE_MODEL=Qwen/Qwen3-4B-Instruct-2507
MIZAN_BASE_REVISION=cdbee75f17c01a7cc42f958dc650907174af0554
MIZAN_BASE_URL=                       # OpenAI-compatible endpoint, without trailing slash
MIZAN_BASE_API_KEY=                   # Keep secret; never commit a real key
MIZAN_SOURCE_REGISTRY=                # Local UTF-8 JSON registry path
MIZAN_NLP_ADVISORY=true
MIZAN_NLP_NATIVE_WSD=1                # Own Arabic sense model (nlp/artifacts/default); unset = off
MIZAN_TARGET_LANGUAGE=any             # any | en | ar
MIZAN_GATE_MAX_RETRIES=1              # 0–2
MIZAN_RETRY_MAX_TOKENS=4096
MIZAN_AUDIT_LOG=                      # Optional local JSONL path; no prompts/responses logged

# ===== OWN MINIMIND CHECKPOINT (text-only RunPod queue worker) =====
# To opt out of owned mode, set MIZAN_OWNED_ONLY=false, LLM_PROVIDER=mizan-minimind
# and DEFAULT_MODEL=Zubairshaikh/mizan-full-sft.
# This is a different architecture/checkpoint from Ruh (RUH_MODEL_PATH).
MINIMIND_ENDPOINT_ID=                # Existing worker endpoint ID; not a pod ID
RUNPOD_API_KEY=                      # Inject from your secret store; never commit
MIZAN_BASE_CONTEXT_WINDOW=32768      # Hybrid display; MiniMind always uses 2048
