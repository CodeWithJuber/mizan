# ╔══════════════════════════════════════════════════════╗
# ║          ميزان  ·  MIZAN Configuration               ║
# ║      Copy to .env and fill in your values            ║
# ╚══════════════════════════════════════════════════════╝

# ===== AI PROVIDERS (at least one required) =====
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=                        # Optional
OPENROUTER_API_KEY=                    # Optional — access 300+ models via openrouter.ai

# ===== MODEL =====
# LLM_PROVIDER=                        # auto-detect | anthropic | openrouter | openai | ollama
DEFAULT_MODEL=claude-sonnet-4-20250514
# OpenRouter models: anthropic/claude-sonnet-4, google/gemini-2.0-flash, meta-llama/llama-4-scout, etc.

# ===== SYSTEM =====
SECRET_KEY=change-this-to-a-secure-random-string
DEBUG=false
LOG_LEVEL=INFO
RUH_ENABLED=true
# al-Insān faculties: when true, Baṣīra/Hawā/Ḥikma actively gate & redirect the
# agent loop (high-severity lower-pull → forceful restraint). Default advisory.
DEEP_FACULTY_LOOP=false
# ===== SERVER =====
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== PRODUCTION DEPLOYMENT =====
# DOMAIN=mizan.example.com          # Your domain (for SSL)
# HTTP_PORT=80                      # Public HTTP port
# HTTPS_PORT=443                    # Public HTTPS port
# SSL_EMAIL=admin@example.com       # Email for Let's Encrypt
# NGINX_CONF=nginx-nossl.conf       # nginx-nossl.conf or nginx.conf (SSL)

# ===== DATABASE =====
DB_PATH=data/mizan.db

# ===== LOCAL AI (Optional) =====
OLLAMA_URL=http://localhost:11434

# ===== CLOUD PROVIDERS (Optional) =====
LINODE_API_TOKEN=                      # Linode Personal Access Token (linodes:read_write scope)

# ===== CHANNELS (Optional) =====
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_APP_TOKEN=
WHATSAPP_TOKEN=

# ===== EMAIL (Optional) =====
EMAIL_HOST=imap.gmail.com
EMAIL_USER=
EMAIL_PASSWORD=

# ===== MIZAN HYBRID RESEARCH RUNTIME (Optional; disabled by default) =====
# Wraps an existing provider with own-NLP advisory and deterministic gates.
# No weights are merged. This is not production or religious certification.
MIZAN_HYBRID_ENABLED=false
MIZAN_BASE_PROVIDER=openai-compatible
MIZAN_BASE_MODEL=Qwen/Qwen3-4B-Instruct-2507
MIZAN_BASE_REVISION=cdbee75f17c01a7cc42f958dc650907174af0554
MIZAN_BASE_URL=                       # OpenAI-compatible endpoint, without trailing slash
MIZAN_BASE_API_KEY=                   # Keep secret; never commit a real key
MIZAN_SOURCE_REGISTRY=                # Local UTF-8 JSON registry path
MIZAN_NLP_ADVISORY=true
MIZAN_NLP_NATIVE_WSD=false            # Existing native-WSD feature flag
MIZAN_TARGET_LANGUAGE=any             # any | en | ar
MIZAN_GATE_MAX_RETRIES=1              # 0–2
MIZAN_RETRY_MAX_TOKENS=4096
MIZAN_AUDIT_LOG=                      # Optional local JSONL path; no prompts/responses logged
