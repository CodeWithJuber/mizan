# Environment
.env
*.env
!.env.example

# Python
__pycache__/
**/__pycache__/
**/*.pyc
*.pyc
*.pyo
venv/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
coverage.xml
.coverage

# Node
node_modules/
.vite/

# Database (local only)
*.db
*.sqlite
*.sqlite3
backend/data/
/data/

# Model checkpoints (large binaries)
ruh_model/checkpoints/
*.pt

# Logs
*.log
/tmp/

# OS
.DS_Store
Thumbs.db

# Claude Code: local config stays private; the shared hooks and skills are committed
.claude/*
!.claude/settings.json
!.claude/skills/
.claude.local.md

# Secrets / local config (.mcp.json holds only ForgeKit's forge-cortex server, no secrets)
backend/.vault.key

# ForgeKit runtime state (the code atlas is rebuilt locally; verify events and config backups are per machine)
.forge/atlas.json
.forge/verify-events.jsonl
.forge/*.forge-bak-*
# Raw ledger records stay per machine: the reviewed Markdown under .forge/brain/facts/,
# .forge/lessons/ and .forge/decisions.md (portableMemory) is what a new checkout rebuilds them from
.forge/ledger/*
!.forge/ledger/.gitignore

# IDE
.vscode/*
!.vscode/mcp.json
.idea/
*.swp
*.swo

# Research pipeline scratch + derived artifacts (results/ and the shipped datasets ARE committed)
backend/research/output/
backend/research/research.db
# Archify delivery receipts hold local paths (docs/diagrams/README.md)
docs/diagrams/*.delivery.json
# Ibrah tasks from real chats stay local; the repository ships synthetic examples
backend/imtihan/tasks/ibrah.jsonl
# Research inputs fetched or built from their sources, never committed
# (backend/research/datasets/LICENSES.md)
backend/research/datasets/quran_words.csv
backend/research/datasets/roots_summary.csv
backend/research/datasets/raw/*
!backend/research/datasets/raw/arabic_font.ttf
backend/research/analyzer/output/
backend/research/experiments/data/
backend/research/experiments/output/
# Candidate sense models are release assets (scripts/fetch_nlp_candidates.py)
nlp/artifacts/candidate_*/model.joblib
