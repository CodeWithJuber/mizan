  "cards": [
    {
      "dot": "amber",
      "title": "Who acts",
      "items": [
        "Fahm picks the recipe by posterior; Tadbir runs every step",
        "The model only writes the two programs",
        "Each run is a tool call through the gate, with a Sakk receipt"
      ]
    },
    {
      "dot": "emerald",
      "title": "When it is verified",
      "items": [
        "Tathabbut: an independent program prints the same numbers in order",
        "Disagreement: the first program is repaired once, else not verified",
        "Hifz keeps only checked programs and re-runs them with no model call"
      ]
    },
    {
      "dot": "slate",
      "title": "Words-only requests",
      "items": [
        "When Fahm recognises no action, handle() returns nothing",
        "The agent then answers in words with no tools",
        "Sidq and Ahl al-Dhikr check that unverified answer before it is shown"
      ]
    }
  ]
