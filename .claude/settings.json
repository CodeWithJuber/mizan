{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": [
    "forge-cortex"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v forge >/dev/null 2>&1 || exit 0; forge hooks run claude SessionStart",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v forge >/dev/null 2>&1 || exit 0; forge hooks run claude UserPromptSubmit",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v forge >/dev/null 2>&1 || exit 0; forge hooks run claude PreToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v forge >/dev/null 2>&1 || exit 0; forge hooks run claude PostToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v forge >/dev/null 2>&1 || exit 0; forge hooks run claude Stop",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v forge >/dev/null 2>&1 || exit 0; forge hooks run claude PostToolUseFailure",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
