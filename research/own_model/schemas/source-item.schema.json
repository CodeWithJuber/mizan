{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mizan:reply:source:v1",
  "title": "Mizan original source item v1",
  "description": "One source item per split-safe passage/conversation lineage. Multiple items may reference one unchanged original asset at distinct locators. data.py additionally checks URI parsing, relative path containment, source-kind metadata, numeric bounds, bytes and split overlaps. Structural validity never establishes authenticity.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "__REPLACE_|\u0000"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+~-]{0,255}(?![\\s\\S])"
    },
    "source_family": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "__REPLACE_|\u0000"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+~-]{0,255}(?![\\s\\S])"
    },
    "kind": {
      "enum": [
        "quran",
        "tafsir",
        "hadith",
        "lexicon",
        "human_dialogue",
        "other"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "__REPLACE_|\u0000"
      },
      "pattern": "\\S"
    },
    "edition": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "__REPLACE_|\u0000"
      },
      "pattern": "\\S"
    },
    "locator": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "__REPLACE_|\u0000"
      },
      "pattern": "\\S"
    },
    "uri": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "__REPLACE_|\u0000"
      },
      "pattern": "^(?:https://\\S+|urn:[A-Za-z0-9][A-Za-z0-9-]{0,31}:\\S+)(?![\\s\\S])"
    },
    "rights": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "__REPLACE_|\u0000"
      },
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "local_path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "__REPLACE_|\u0000"
          },
          {
            "pattern": "(^/|(^|/)\\.\\.(/|$))"
          }
        ]
      },
      "pattern": "\\S"
    },
    "quran": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surah": {
          "type": "integer",
          "minimum": 1,
          "maximum": 114
        },
        "ayah_start": {
          "type": "integer",
          "minimum": 1,
          "maximum": 286
        },
        "ayah_end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 286
        },
        "text_edition": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "__REPLACE_|\u0000"
          },
          "pattern": "\\S"
        }
      },
      "required": [
        "surah",
        "ayah_start",
        "ayah_end",
        "text_edition"
      ]
    },
    "tafsir": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "__REPLACE_|\u0000"
          },
          "pattern": "\\S"
        },
        "work": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "__REPLACE_|\u0000"
          },
          "pattern": "\\S"
        },
        "passage": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "__REPLACE_|\u0000"
          },
          "pattern": "\\S"
        },
        "reviewer_qualification": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "__REPLACE_|\u0000"
          },
          "pattern": "\\S"
        }
      },
      "required": [
        "author",
        "work",
        "passage",
        "reviewer_qualification"
      ]
    },
    "hadith": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collection": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "__REPLACE_|\u0000"
          },
          "pattern": "\\S"
        },
        "book": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "__REPLACE_|\u0000"
          },
          "pattern": "\\S"
        },
        "number": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "__REPLACE_|\u0000"
          },
          "pattern": "\\S"
        },
        "gradings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "grade": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "__REPLACE_|\u0000"
                },
                "pattern": "\\S"
              },
              "grader": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "__REPLACE_|\u0000"
                },
                "pattern": "\\S"
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "__REPLACE_|\u0000"
                },
                "pattern": "\\S"
              }
            },
            "required": [
              "grade",
              "grader",
              "reference"
            ]
          }
        },
        "reviewer_qualification": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "__REPLACE_|\u0000"
          },
          "pattern": "\\S"
        }
      },
      "required": [
        "collection",
        "book",
        "number",
        "gradings",
        "reviewer_qualification"
      ]
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "__REPLACE_|\u0000"
      },
      "pattern": "\\S"
    }
  },
  "required": [
    "source_id",
    "source_family",
    "kind",
    "title",
    "edition",
    "locator",
    "uri",
    "rights",
    "sha256",
    "local_path"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "quran"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "quran"
        ]
      },
      "else": {
        "not": {
          "required": [
            "quran"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "tafsir"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "tafsir"
        ]
      },
      "else": {
        "not": {
          "required": [
            "tafsir"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "hadith"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "hadith"
        ]
      },
      "else": {
        "not": {
          "required": [
            "hadith"
          ]
        }
      }
    }
  ]
}
